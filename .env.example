# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis
REDIS_URL=redis://localhost:6379/0

# Kotak Neo API (v2 — TOTP + MPIN auth, no consumer_secret needed)
KOTAK_CONSUMER_KEY=
KOTAK_UCC=
KOTAK_MOBILE=

# ICICI Breeze API
ICICI_API_KEY=
ICICI_API_SECRET=

# Trendlyne
TRENDLYNE_API_KEY=

# News APIs
NEWS_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:33b

# OpenAI (ChatGPT) - optional cloud LLM provider, used via apps.llm.services.llm_router
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Which LLM provider apps.llm.services.llm_router.get_llm_client() uses by default: vllm | ollama | openai
LLM_DEFAULT_PROVIDER=vllm

# Paper Trading
PAPER_TRADING=True

# Investments app (Family Portfolio Intelligence)
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
INVESTMENTS_ENCRYPTION_KEY=
